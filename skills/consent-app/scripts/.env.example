# Consent App skill configuration.
# Copy this file to ".env" (same folder) and fill in your key, OR just tell
# Claude Cowork "set my Consent App key to cak_..." and it writes it for you.
# Format is KEY=VALUE, one per line. Shell-set variables take precedence.

# Your Consent App API key (shape: cak_eu_... or cak_us_...), created at
# https://consent.app/portal/api-keys with the scope "Create requests".
CONSENT_API_KEY=
